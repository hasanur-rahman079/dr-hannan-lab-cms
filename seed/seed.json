          "scholar_url": "https://scholar.google.com/citations?hl=en&user=-hsEFR0AAAAJ",
          "research_interests": "Natural Product Research; Phytomedicine; Network Biology; Marine Biotechnology; Lifestyle diseases"
        }
      }
    ],
    "research_areas": [
      {
        "id": "research-1",
