{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Starter",
    "description": "A minimal EmDash starter with posts and pages",
    "author": "EmDash"
  },
  "settings": {
    "title": "My Site",
    "tagline": "Built with EmDash"
  },
  "collections": [
    {
      "slug": "posts",
      "label": "Posts",
      "labelSingular": "Post",
      "urlPattern": "/posts/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "search",
        "seo"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "featured_image",
          "label": "Featured Image",
          "type": "image"
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "excerpt",
          "label": "Excerpt",
          "type": "text"
        }
      ]
    },
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "urlPattern": "/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "search",
        "seo"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        }
      ]
    },
    {
      "slug": "professor_profiles",
      "fields": [
        {
          "slug": "name",
          "label": "Full name",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "academic_title",
          "label": "Academic title",
          "type": "string"
        },
        {
          "slug": "department",
          "label": "Department",
          "type": "string"
        },
        {
          "slug": "institution",
          "label": "Institution",
          "type": "string"
        },
        {
          "slug": "institution_url",
          "label": "Institution website",
          "type": "url"
        },
        {
          "slug": "professional_email",
          "label": "Professional email",
          "type": "string"
        },
        {
          "slug": "homepage_url",
          "label": "Personal homepage",
          "type": "url"
        },
        {
          "slug": "scholar_url",
          "label": "Google Scholar profile",
          "type": "url"
        },
        {
          "slug": "biography",
          "label": "Biography",
          "type": "text"
        },
        {
          "slug": "research_interests",
          "label": "Research interests",
          "type": "text"
        }
      ],
      "label": "Professor Profiles"
    },
    {
      "slug": "research_areas",
      "fields": [
        {
          "slug": "title",
          "label": "Area name",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "summary",
          "label": "Short description",
          "type": "text"
        },
        {
          "slug": "display_order",
          "label": "Display order",
          "type": "integer"
        }
      ],
      "label": "Research Areas"
    },
    {
      "slug": "publications",
      "fields": [
        {
          "slug": "title",
          "label": "Publication title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "authors",
          "label": "Authors",
          "type": "text"
        },
        {
          "slug": "journal",
          "label": "Journal",
          "type": "string"
        },
        {
          "slug": "publication_year",
          "label": "Publication year",
          "type": "integer"
        },
        {
          "slug": "doi_url",
          "label": "DOI link",
          "type": "url"
        },
        {
          "slug": "scholar_url",
          "label": "Scholar link",
          "type": "url"
        },
        {
          "slug": "abstract",
          "label": "Abstract or note",
          "type": "text"
        }
      ],
      "label": "Publications"
    },
    {
      "slug": "research_projects",
      "fields": [
        {
          "slug": "title",
          "label": "Project title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "summary",
          "label": "Summary",
          "type": "text"
        },
        {
          "slug": "project_status",
          "label": "Status",
          "type": "string"
        },
        {
          "slug": "start_year",
          "label": "Start year",
          "type": "integer"
        },
        {
          "slug": "end_year",
          "label": "End year",
          "type": "integer"
        },
        {
          "slug": "project_url",
          "label": "Project link",
          "type": "url"
        }
      ],
      "label": "Research Projects"
    },
    {
      "slug": "lab_members",
      "fields": [
        {
          "slug": "name",
          "label": "Name",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "role",
          "label": "Role",
          "type": "string"
        },
        {
          "slug": "bio",
          "label": "Short biography",
          "type": "text"
        },
        {
          "slug": "email",
          "label": "Professional email",
          "type": "string"
        },
        {
          "slug": "profile_url",
          "label": "Profile link",
          "type": "url"
        },
        {
          "slug": "display_order",
          "label": "Display order",
          "type": "integer"
        }
      ],
      "label": "Lab Members"
    },
    {
      "slug": "lab_news",
      "fields": [
        {
          "slug": "title",
          "label": "Headline",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "summary",
          "label": "Summary",
          "type": "text"
        },
        {
          "slug": "published_on",
          "label": "Published date",
          "type": "string"
        },
        {
          "slug": "link_url",
          "label": "Related link",
          "type": "url"
        }
      ],
      "label": "Lab News"
    }
  ],
  "taxonomies": [
    {
      "name": "category",
      "label": "Categories",
      "labelSingular": "Category",
      "hierarchical": true,
      "collections": [
        "posts"
      ],
      "terms": [
        {
          "slug": "general",
          "label": "General"
        },
        {
          "slug": "updates",
          "label": "Updates"
        }
      ]
    },
    {
      "name": "tag",
      "label": "Tags",
      "labelSingular": "Tag",
      "hierarchical": false,
      "collections": [
        "posts"
      ],
      "terms": [
        {
          "slug": "starter",
          "label": "Starter"
        },
        {
          "slug": "example",
          "label": "Example"
        }
      ]
    }
  ],
  "menus": [
    {
      "name": "primary",
      "label": "Primary Navigation",
      "items": [
        {
          "type": "custom",
          "label": "Home",
          "url": "/"
        },
        {
          "type": "custom",
          "label": "Posts",
          "url": "/posts"
        },
        {
          "type": "custom",
          "label": "About",
          "url": "/about"
        }
      ]
    }
  ],
  "widgetAreas": [
    {
      "name": "sidebar",
      "label": "Sidebar",
      "description": "Sidebar widget area",
      "widgets": [
        {
          "type": "component",
          "componentId": "core:search",
          "title": "Search"
        },
        {
          "type": "component",
          "componentId": "core:categories",
          "title": "Categories"
        },
        {
          "type": "component",
          "componentId": "core:recent-posts",
          "title": "Recent Posts",
          "props": {
            "count": 5
          }
        }
      ]
    }
  ],
  "content": {
    "pages": [
      {
        "id": "about",
        "slug": "about",
        "status": "published",
        "data": {
          "title": "About",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "This is the about page. Edit it in the admin panel or replace this template with your own design.",
                  "_key": "k1"
                }
              ],
              "_key": "k0"
            }
          ]
        }
      }
    ],
    "posts": [
      {
        "id": "post-1",
        "slug": "welcome",
        "status": "published",
        "data": {
          "title": "Welcome",
          "excerpt": "Your first post. Replace this with your own content.",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "This is a starter post. The templates in this project show the basic patterns for querying and rendering EmDash content. Replace them with your own design.",
                  "_key": "k1"
                }
              ],
              "_key": "k0"
            },
            {
              "_type": "block",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "What to do next",
                  "_key": "k3"
                }
              ],
              "_key": "k2"
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Open the admin panel to add content, or edit the Astro pages in src/pages to change how content is displayed.",
                  "_key": "k5"
                }
              ],
              "_key": "k4"
            }
          ]
        },
        "taxonomies": {
          "category": [
            "general"
          ],
          "tag": [
            "starter",
            "example"
          ]
        }
      }
    ],
    "professor_profiles": [
      {
        "id": "hanan-profile",
        "slug": "hanan-profile",
        "status": "published",
        "data": {
          "name": "Professor Dr. Md. Abdul Hannan",
          "academic_title": "Professor",
